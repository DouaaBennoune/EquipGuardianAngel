    "def scaler_test_process(df,scaler,feature_cols):\n",
    "\n",
    "    x_scaled=scaler.transform(df[feature_cols])\n",
    "    indexes=df[feature_cols]\n",
    "    x_scaled=pd.DataFrame(\n",
    "        x_scaled,\n",
    "        columns=feature_cols,\n",
    "        index=indexes.index\n",
    "    )\n",
    "    x_scaled['cycle']=df['cycle']\n",
    "    x_scaled['id']=df['id']\n",
    "    return x_scaled"
   ]
  },
  {
