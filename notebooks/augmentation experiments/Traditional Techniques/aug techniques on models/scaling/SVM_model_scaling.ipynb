    "    if pred < act:\n",
    "        pessimistic_count += 1  # Use += to save the value\n",
    "    else:\n",
    "        optimistic_count += 1\n",
    "\n",
    "# 4. Print results\n",
    "print(f\"Pessimistic predictions: {pessimistic_count}\")\n",
    "print(f\"Optimistic predictions: {optimistic_count}\")\n",
